{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curiosity.local/docs/status/schema.json",
  "title": "Curiosity scope-qualified capability status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "workspaces",
    "sourceContracts",
    "capabilities"
  ],
  "properties": {
    "$schema": { "const": "./schema.json" },
    "schemaVersion": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "const": "wave-2-verification-v1" }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workspace" }
    },
    "sourceContracts": { "$ref": "#/$defs/sourceContracts" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9@._-]+(?:/[A-Za-z0-9@._-]+)*$"
    },
    "repositoryReference": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9@._-]+(?:/[A-Za-z0-9@._-]+)*#(?=[A-Za-z0-9 ._:/@+()\\[\\]-]*[A-Za-z0-9])[A-Za-z0-9._:/@+()\\[\\]-](?:[A-Za-z0-9 ._:/@+()\\[\\]-]*[A-Za-z0-9._:/@+()\\[\\]-])?$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "test",
            "decision",
            "section",
            "receipt",
            "external"
          ]
        },
        "ref": {
          "allOf": [
            { "$ref": "#/$defs/repositoryReference" },
            { "type": "string", "pattern": "^(?!.*(?:#L[0-9]+|:line-[0-9]+))" }
          ]
        }
      }
    },
    "refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "kind", "private"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/repositoryPath" },
            { "type": "string", "pattern": "^(apps|packages)/" }
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "harness",
            "plugin",
            "runtime",
            "starter-app",
            "starter-library",
            "configuration"
          ]
        },
        "private": { "type": "boolean" }
      }
    },
    "sourceContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "exports",
        "capabilityReport",
        "adrIndexes",
        "historicalSnapshots",
        "retiredSurfaces",
        "forbiddenProductPatterns",
        "guardedSources"
      ],
      "properties": {
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "features", "entryExport"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "features": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "entryExport": { "$ref": "#/$defs/repositoryReference" }
          }
        },
        "exports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "keys"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "capabilityReport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "export", "pinnedVersion", "capabilities"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "export": { "type": "string" },
            "pinnedVersion": { "type": "string" },
            "capabilities": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "code"],
                "properties": {
                  "status": { "const": "disabled" },
                  "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
                }
              }
            }
          }
        },
        "adrIndexes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "required"],
            "properties": {
              "path": { "$ref": "#/$defs/repositoryPath" },
              "required": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        },
        "historicalSnapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "classification", "authority", "historyRule"],
            "properties": {
              "path": {
                "const": "apps/plugin/opencode2/docs/architecture/preflight-2026-08-12.md"
              },
              "classification": { "const": "immutable-historical" },
              "authority": { "const": "not-current" },
              "historyRule": { "const": "fixed-baseline-index-blob" }
            }
          }
        },
        "retiredSurfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "forbiddenProductPatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["roots", "patterns"],
            "properties": {
              "roots": {
                "type": "array",
                "items": { "$ref": "#/$defs/repositoryPath" }
              },
              "patterns": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "guardedSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/repositoryPath" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "level",
        "environments",
        "platforms",
        "constraints"
      ],
      "properties": {
        "product": {
          "enum": ["repository", "harness", "plugin", "runtime", "scaffolds"]
        },
        "level": {
          "enum": [
            "repository",
            "package",
            "private-profile",
            "test-only",
            "design",
            "retired"
          ]
        },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["repository", "development", "test", "private-release"]
          }
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mode", "sha256"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "mode": { "const": "exact" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "mode"],
          "properties": {
            "path": { "$ref": "#/$defs/repositoryPath" },
            "mode": { "const": "absent" }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owners",
        "scope",
        "observation",
        "assertion",
        "evidence",
        "authority",
        "delivery",
        "qualification",
        "availability",
        "status",
        "verdict",
        "blockerCodes",
        "guards"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["repository", "harness", "plugin", "runtime", "scaffolds"]
          }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "refs"],
          "properties": {
            "state": {
              "enum": [
                "implemented",
                "partial",
                "absent",
                "design-only",
                "unknown",
                "contradictory"
              ]
            },
            "refs": { "$ref": "#/$defs/refs" }
          }
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "code", "refs"],
          "properties": {
            "state": { "enum": ["positive", "limited", "negative"] },
            "code": {
              "enum": [
                "validated-positive",
                "scope-limited",
                "validated-negative"
              ]
            },
            "refs": { "$ref": "#/$defs/refs" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "refs"],
          "properties": {
            "state": {
              "enum": [
                "sufficient",
                "partial",
                "missing",
                "contradictory",
                "not-required"
              ]
            },
            "refs": { "$ref": "#/$defs/refs" }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "refs"],
          "properties": {
            "state": {
              "enum": [
                "authorized",
                "limited",
                "unauthorized",
                "forbidden",
                "unknown",
                "not-required"
              ]
            },
            "refs": { "$ref": "#/$defs/refs" }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "refs"],
          "properties": {
            "state": {
              "enum": [
                "composed",
                "exported",
                "registry-ready",
                "private-release",
                "conditional",
                "internal",
                "test-only",
                "design-only",
                "absent",
                "retired"
              ]
            },
            "refs": { "$ref": "#/$defs/refs" }
          }
        },
        "qualification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "platforms", "refs"],
          "properties": {
            "state": {
              "enum": [
                "qualified",
                "conditional",
                "unqualified",
                "contradictory",
                "unknown",
                "not-required"
              ]
            },
            "platforms": { "type": "array", "items": { "type": "string" } },
            "refs": { "$ref": "#/$defs/refs" }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "environments",
            "production",
            "publication",
            "deployment"
          ],
          "properties": {
            "state": {
              "enum": [
                "enabled",
                "observation-only",
                "conditional",
                "disabled",
                "absent",
                "unknown",
                "not-applicable"
              ]
            },
            "environments": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["repository", "development", "test", "private-release"]
              }
            },
            "production": { "const": "disabled" },
            "publication": {
              "enum": ["unpublished", "unknown", "not-applicable"]
            },
            "deployment": { "const": "disabled" }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": ["enabled", "observation-only", "conditional"]
                  }
                },
                "required": ["state"]
              },
              "then": {
                "properties": {
                  "environments": { "type": "array", "minItems": 1 }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": ["disabled", "absent", "unknown", "not-applicable"]
                  }
                },
                "required": ["state"]
              },
              "then": {
                "properties": {
                  "environments": { "type": "array", "maxItems": 0 }
                }
              }
            }
          ]
        },
        "status": {
          "enum": ["Current", "Experimental", "Deferred", "Retired"]
        },
        "verdict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "rationaleCode"],
          "properties": {
            "decision": { "enum": ["GO", "CONDITIONAL", "NO-GO", "RETIRED"] },
            "rationaleCode": {
              "enum": [
                "scope-qualified-current",
                "bounded-experimental",
                "fail-closed-deferred",
                "verified-retirement"
              ]
            }
          }
        },
        "blockerCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "authoritative-fencing-required",
              "host-persistence-qualification-required",
              "live-endpoint-qualification-required",
              "broader-delivery-authority-required",
              "publication-review-required",
              "trusted-command-callback-required",
              "durable-replay-required",
              "composition-authority-required",
              "ledger-fencing-required",
              "unresolved-design-decisions",
              "implementation-authority-required",
              "coherent-candidate-required",
              "platform-qualification-required",
              "product-definition-required",
              "source-requalification-required"
            ]
          }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/guard" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "observation": {
                "type": "object",
                "properties": { "state": { "const": "absent" } },
                "required": ["state"]
              }
            },
            "required": ["observation"]
          },
          "then": {
            "properties": {
              "availability": {
                "type": "object",
                "properties": {
                  "environments": { "type": "array", "maxItems": 0 }
                },
                "required": ["environments"]
              }
            }
          }
        }
      ]
    }
  }
}
