{
  "name": "@curiosity/authority",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "node tools/verify-portable-imports.mjs",
    "test": "bun test tests/*.test.ts",
    "verify": "bun run lint && bun run check-types && bun run build && bun run test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  }
}
