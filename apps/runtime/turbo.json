{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "$TURBO_EXTENDS$",
        "native/target/debug/libcuriosity_runtime_native.dylib"
      ]
    },
    "build:native:release": {
      "outputs": ["native/target/release/libcuriosity_runtime_native.dylib"]
    },
    "m7:prepare": {
      "dependsOn": [
        "build:native:release",
        "@iamsterling/opencode2-config#m7:prepare"
      ]
    },
    "m7:test:run": {
      "dependsOn": ["m7:prepare"]
    },
    "verify:run": {
      "dependsOn": ["m7:prepare"]
    }
  }
}
