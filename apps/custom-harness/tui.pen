                          "type": "text",
                          "id": "nLoWW",
                          "name": "Code",
                          "fill": "$code",
                          "content": "if (record.generation !== fence.generation) {",
                          "lineHeight": "$lh",
                          "fontFamily": "$mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "AoW9g",
                          "name": "Code",
                          "fill": "$code",
                          "content": "  return Effect.fail(new AttemptFenced({ record, fence }))",
                          "lineHeight": "$lh",
                          "fontFamily": "$mono",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
