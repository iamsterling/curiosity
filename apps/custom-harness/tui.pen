                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Fencing is enforced at commit, not at dispatch. `AttemptRecord.generation` is compared inside the writer transaction, so a supervisor restart that re-arms an in-flight tool call is rejected — but only when the effect already reached the ledger.",
                      "lineHeight": 1.7,
                      "fontFamily": "$mono",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    },
