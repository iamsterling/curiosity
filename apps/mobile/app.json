{
  "expo": {
    "name": "Curiosity",
    "slug": "curiosity",
    "scheme": "curiosity",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "platforms": ["ios"],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": ["./plugins/with-ios-scene-lifecycle.cjs", "expo-router"],
    "ios": {
      "bundleIdentifier": "com.iamsterling.curiosity",
      "supportsTablet": true,
      "requireFullScreen": false
    }
  }
}
