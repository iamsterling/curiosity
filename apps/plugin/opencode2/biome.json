{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "package.json",
      "tsconfig.json",
      "tsconfig.build.json",
      "biome.json",
      "assets/manifest.json"
    ]
  }
}
