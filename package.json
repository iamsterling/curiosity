{
  "name": "curiosity",
  "private": true,
  "trustedDependencies": [],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "node --test --test-concurrency=1 tools/status/status.test.mjs tools/verification/*.test.mjs && turbo run test",
    "verify": "bun run inventory:check && bun run status:check && turbo run verify && node tools/verification/runtime-plugin-contract.mjs --no-build",
    "inventory:check": "node --test --test-concurrency=1 tools/verification/*.test.mjs && node tools/verification/inventory.mjs",
    "status:check": "node --test tools/status/status.test.mjs && node tools/status/status.mjs",
    "status:write": "node tools/status/status.mjs --write",
    "verify:legacy-memory-parity": "node apps/plugin/opencode2/tools/verify-legacy-memory-native-parity.mjs --verify-dependency-receipt && bun run --cwd apps/plugin/opencode2 build && node apps/plugin/opencode2/tools/verify-legacy-memory-native-parity.mjs --verify-baseline-blobs && node apps/plugin/opencode2/tools/verify-legacy-memory-native-parity.mjs",
    "verify:legacy-memory-node-api-sdk": "bun apps/plugin/opencode2/tests/qualification/verify-legacy-memory-node-api-sdk.mjs",
    "verify:legacy-memory-node-api-sdk-v2": "bun apps/plugin/opencode2/tests/qualification/verify-legacy-memory-node-api-sdk-v2.mjs",
    "contract:runtime-plugin": "node tools/verification/runtime-plugin-contract.mjs",
    "runtime:portable": "bun run --cwd apps/runtime verify:portable",
    "runtime:network-denied": "bun run --cwd apps/runtime test:network-denied",
    "runtime:darwin-compatibility": "bun run --cwd apps/runtime verify:darwin-compatibility"
  },
  "devDependencies": {
    "@curiosity/runtime": "workspace:*",
    "@types/node": "^22.15.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "ajv": "8.17.1",
    "he": "1.2.0",
    "marked": "12.0.2",
    "prettier": "^3.7.4",
    "turbo": "^2.10.10",
    "typescript": "5.9.2",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "apps/plugin/*",
    "packages/*",
    "vendor/crafty/packages/editor",
    "vendor/crafty/packages/pen-import",
    "vendor/crafty/packages/scene-model",
    "vendor/crafty/packages/scene-renderer",
    "vendor/crafty/packages/scene-store"
  ]
}
