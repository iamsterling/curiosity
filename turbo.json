{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "CARGO",
    "CARGO_FMT",
    "CARGO_CLIPPY",
    "RUSTC",
    "RUSTDOC",
    "CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER",
    "CARGO_HOME",
    "CARGO_TARGET_DIR",
    "CARGO_NET_OFFLINE",
    "MACOSX_DEPLOYMENT_TARGET",
    "RUSTFLAGS",
    "LC_ALL",
    "TMPDIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
